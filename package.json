{
  "name": "unconference3",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "docker compose up -d && npx tsx server/database/migrate.ts && nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "npx tsx server/database/seed.ts",
    "db:seed:prod": "node /app/server/database/seed.mjs",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 3",
    "test:watch": "vitest --watch",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.1",
    "@nuxt/test-utils": "^4.0.3",
    "@sendgrid/mail": "^8.1.6",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^8.0.7",
    "nuxt": "^4.4.5",
    "nuxt-auth-utils": "^0.5.29",
    "postgres": "^3.4.8",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4"
  },
  "overrides": {
    "@protobufjs/utf8": "1.1.1",
    "anymatch": {
      "picomatch": "^2.3.2"
    },
    "axios": "^1.16.1",
    "brace-expansion": "^5.0.6",
    "editorconfig": {
      "brace-expansion": "^2.1.0"
    },
    "js-beautify": {
      "brace-expansion": "^2.1.0"
    },
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/nodemailer": "^7.0.11",
    "@vue/test-utils": "^2.4.6",
    "crossws": "^0.4.5",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.9.0",
    "playwright-core": "^1.58.2",
    "testcontainers": "^11.14.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.0",
    "vuetify": "^4.0.3"
  }
}
